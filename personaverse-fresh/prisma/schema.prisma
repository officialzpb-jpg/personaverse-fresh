generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  status           String
  priceId          String?
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  personaId String
  createdAt DateTime @default(now())

  @@unique([userId, personaId])
  @@index([userId])
  @@index([personaId])
  @@map("likes")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  personaId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, personaId])
  @@index([userId])
  @@index([personaId])
  @@map("reviews")
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  personaId String
  title     String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("chats")
}

model Persona {
  id           String   @id @default(cuid())
  userId       String
  name         String
  avatar       String
  description  String
  systemPrompt String   @db.Text
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([userId])
  @@map("personas")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  plan          String    @default("free")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  apiKeys      ApiKey[]

  @@map("users")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  key       String   @unique
  name      String?
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model ApiUsage {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  tokens    Int?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("api_usage")
}

// Battle Arena Models
model Battle {
  id          String   @id @default(cuid())
  topic       String
  status      String   @default("active") // active, completed, scheduled
  persona1Id  String
  persona2Id  String
  persona1Votes Int    @default(0)
  persona2Votes Int    @default(0)
  createdAt   DateTime @default(now())
  endsAt      DateTime
  winnerId    String?
  
  messages    BattleMessage[]
  votes       BattleVote[]
  
  @@index([status])
  @@index([endsAt])
  @@map("battles")
}

model BattleMessage {
  id        String   @id @default(cuid())
  battleId  String
  personaId String
  content   String   @db.Text
  round     Int
  createdAt DateTime @default(now())
  
  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  
  @@index([battleId])
  @@index([round])
  @@map("battle_messages")
}

model BattleVote {
  id        String   @id @default(cuid())
  battleId  String
  userId    String?
  personaId String
  createdAt DateTime @default(now())
  
  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  
  @@unique([battleId, userId])
  @@index([battleId])
  @@map("battle_votes")
}

model BattleLeaderboard {
  id          String   @id @default(cuid())
  personaId   String   @unique
  personaName String
  wins        Int      @default(0)
  losses      Int      @default(0)
  debates     Int      @default(0)
  updatedAt   DateTime @updatedAt
  
  @@index([wins])
  @@map("battle_leaderboard")
}
